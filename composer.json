{
    "name": "kzxl/lite-export",
    "description": "High-performance, memory-efficient streaming Excel (XLSX) and CSV export engine in pure PHP 8.2+ with zero external dependencies and Formula Injection mitigation (< 16MB RAM for 100K+ rows).",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/kzxl/LiteExport",
    "support": {
        "issues": "https://github.com/kzxl/LiteExport/issues",
        "source": "https://github.com/kzxl/LiteExport"
    },
    "authors": [
        {
            "name": "Phong Vo",
            "email": "phong.vo@kzxl.com"
        }
    ],
    "keywords": [
        "export",
        "excel",
        "xlsx",
        "csv",
        "streaming",
        "low-memory",
        "openxml",
        "formula-injection",
        "php82"
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "LiteExport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LiteExport\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always"
    }
}
